---
import { NAV, SITE } from "../config";
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/">
          <img src="/favicon.svg" alt="" width="32" height="32" />
          <span>{SITE.name}</span>
        </a>
        <p>
          Azure cloud &amp; platform architect with strong Linux expertise.
          Architecture that works beyond go-live — and tinkering with a home
          lab and a camera after hours.
        </p>
      </div>

      <div>
        <h4>Explore</h4>
        <ul>
          {NAV.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4>Connect</h4>
        <ul>
          <li><a href={SITE.social.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></li>
          <li><a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></li>
          <li><a href="/rss.xml">RSS feed</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {SITE.name}. All rights reserved.</span>
      <span>
        Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
        · Hosted on Cloudflare Pages
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 56px;
    padding-top: 64px;
    border-top: 1px solid var(--border);
    background: linear-gradient(to bottom, transparent, var(--bg-soft));
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 44px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-heading);
    font-weight: 650;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .brand img {
    border-radius: 8px;
  }

  .footer-brand p {
    color: var(--muted);
    max-width: 380px;
    margin: 16px 0 0;
    font-size: 0.94rem;
  }

  h4 {
    margin-bottom: 14px;
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  ul a {
    color: var(--muted);
    font-size: 0.94rem;
    transition: color var(--transition);
  }

  ul a:hover,
  .footer-bottom a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 22px;
    border-top: 1px solid var(--border);
    color: var(--subtle);
    font-size: 0.82rem;
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
