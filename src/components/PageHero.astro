---
interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
  lead?: string;
}

const { eyebrow, title, accent, lead } = Astro.props;
---

<section class="page-hero">
  <div class="aurora" aria-hidden="true"></div>
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>
      {title}
      {accent && <span class="grad-text">{accent}</span>}
    </h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding-block: 96px 48px;
  }

  h1 {
    font-size: clamp(2.5rem, 5.6vw, 4.2rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
    max-width: 18ch;
  }

  h1 span {
    display: block;
  }

  .lead {
    max-width: 640px;
    margin: 24px 0 0;
  }

  @media (max-width: 680px) {
    .page-hero {
      padding-block: 56px 32px;
    }
  }
</style>
