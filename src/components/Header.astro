---
import { NAV, SITE } from "../config";

interface Props {
  active?: string;
}

const { active = "" } = Astro.props;
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} — home`}>
      <img src="/logo-ph.svg" alt="" width="44" height="44" />
      <span>{SITE.name}</span>
    </a>

    <nav id="primary-nav" aria-label="Main navigation">
      {NAV.map((item) => (
        <a
          href={item.href}
          class:list={{ active: active === item.id }}
          aria-current={active === item.id ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
      <a
        class:list={["nav-contact", { active: active === "contact" }]}
        href="/contact/"
        aria-current={active === "contact" ? "page" : undefined}
      >
        Contact
      </a>
    </nav>

    <div class="actions">
      <button
        class="icon-btn"
        id="theme-toggle"
        type="button"
        aria-label="Toggle colour theme"
      >
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>

      <a class="btn btn-primary cta" href="/contact/" aria-current={active === "contact" ? "page" : undefined}>Contact</a>

      <button
        class="icon-btn menu-btn"
        id="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="bar-top" d="M4 7h16"></path>
          <path class="bar-mid" d="M4 12h16"></path>
          <path class="bar-bot" d="M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition), background var(--transition);
  }

  .site-header.scrolled {
    border-bottom-color: var(--border);
  }

  .header-inner {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 640;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .brand img {
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 10px;
  }

  /* The cream container needs a faint edge to separate from the light page background */
  :global(:root[data-theme="light"]) .brand img {
    outline: 1px solid rgba(11, 26, 18, 0.14);
    outline-offset: -1px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }

  nav a {
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 500;
    transition: color var(--transition), background var(--transition);
  }

  nav a:hover {
    color: var(--text);
    background: var(--accent-soft);
  }

  nav a.active {
    color: var(--accent);
    background: var(--accent-soft);
  }

  /* Desktop shows the Contact button instead; the mobile menu lists it as a link */
  .nav-contact {
    display: none;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .cta {
    padding: 9px 18px;
    font-size: 0.88rem;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-btn);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    cursor: pointer;
    transition: border-color var(--transition), color var(--transition);
  }

  .icon-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .icon-moon {
    display: none;
  }

  :global(:root[data-theme="dark"]) .icon-sun {
    display: none;
  }

  :global(:root[data-theme="dark"]) .icon-moon {
    display: block;
  }

  .menu-btn {
    display: none;
  }

  .menu-btn path {
    transform-origin: center;
    transition: transform var(--transition), opacity var(--transition);
  }

  .site-header.open .bar-top {
    transform: translateY(5px) rotate(45deg);
  }

  .site-header.open .bar-mid {
    opacity: 0;
  }

  .site-header.open .bar-bot {
    transform: translateY(-5px) rotate(-45deg);
  }

  @media (max-width: 860px) {
    .brand {
      font-size: 1.08rem;
      gap: 11px;
    }

    .brand img {
      width: 40px;
      height: 40px;
    }

    .menu-btn {
      display: grid;
    }

    .cta {
      display: none;
    }

    .nav-contact {
      display: block;
    }

    .actions {
      margin-left: auto;
    }

    nav {
      position: absolute;
      top: var(--header-h);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 12px var(--page-gutter) 20px;
      margin: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-md);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity var(--transition), transform var(--transition), visibility var(--transition);
    }

    .site-header.open nav {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    nav a {
      padding: 14px 16px;
      font-size: 1rem;
      border-radius: var(--radius-md);
    }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const menuBtn = document.getElementById("menu-toggle");
  const themeBtn = document.getElementById("theme-toggle");

  const onScroll = () => header?.classList.toggle("scrolled", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const setMenu = (open: boolean) => {
    header?.classList.toggle("open", open);
    menuBtn?.setAttribute("aria-expanded", String(open));
    menuBtn?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  };

  menuBtn?.addEventListener("click", () =>
    setMenu(!header?.classList.contains("open")),
  );
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && header?.classList.contains("open")) {
      setMenu(false);
      menuBtn?.focus();
    }
  });
  document.querySelectorAll("#primary-nav a").forEach((a) =>
    a.addEventListener("click", () => setMenu(false)),
  );

  // The accessible name always describes the action the button will perform
  const syncThemeLabel = () => {
    const dark = document.documentElement.getAttribute("data-theme") === "dark";
    themeBtn?.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
  };
  syncThemeLabel();
  // Also covers theme changes that don't come from this button (e.g. the system setting)
  new MutationObserver(syncThemeLabel).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });

  themeBtn?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    syncThemeLabel();
    try {
      localStorage.setItem("theme", next);
    } catch {
      /* storage unavailable — theme still applies for this visit */
    }
  });
</script>
