---
import "@fontsource-variable/manrope";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import "../styles/diagrams.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config";

interface Props {
  title: string;
  description: string;
  active?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  active = "",
  image = SITE.ogImage,
  type = "website",
  publishedTime,
  noindex = false,
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  url: SITE.url,
  jobTitle: SITE.jobTitle,
  worksFor: {
    "@type": "Organization",
    name: SITE.employer.name,
    url: SITE.employer.url,
  },
  sameAs: [SITE.social.linkedin, SITE.social.github],
  knowsAbout: SITE.knowsAbout,
};

const structuredData = jsonLd ?? (active === "" && Astro.url.pathname === "/" ? person : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#060e0a" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — Field Notes`}
      href="/rss.xml"
    />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!--
      Theme, resolved before first paint (this script is inline and blocking):
      1. a saved manual choice, else 2. the system setting, else 3. dark.
      System changes are followed only while there is no saved choice.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add("js");

        var read = function () {
          try {
            var saved = localStorage.getItem("theme");
            return saved === "light" || saved === "dark" ? saved : null;
          } catch (e) {
            return null;
          }
        };
        var mq = window.matchMedia ? window.matchMedia("(prefers-color-scheme: light)") : null;
        var system = function () {
          return mq && mq.matches ? "light" : "dark";
        };

        root.setAttribute("data-theme", read() || system());

        // Keep the browser UI colour in step with whichever theme is active
        var meta = document.querySelector('meta[name="theme-color"]');
        var paintMeta = function () {
          if (meta) meta.setAttribute("content", root.getAttribute("data-theme") === "light" ? "#f4f9f6" : "#060e0a");
        };
        paintMeta();
        new MutationObserver(paintMeta).observe(root, { attributes: true, attributeFilter: ["data-theme"] });

        if (mq) {
          var onChange = function () {
            if (!read()) root.setAttribute("data-theme", system());
          };
          if (mq.addEventListener) mq.addEventListener("change", onChange);
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header active={active} />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      // Scroll-reveal
      const items = document.querySelectorAll<HTMLElement>(".reveal");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("in");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add("in"));
      }
    </script>
  </body>
</html>
