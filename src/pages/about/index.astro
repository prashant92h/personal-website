---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { stats } from "../../data/projects";

const experience = [
  {
    company: "IBM",
    role: "Senior Advisory Consultant",
    period: "May 2021 – Present",
    current: true,
    description:
      "Supporting 50+ enterprise applications on Azure and Azure DevOps across architecture and modernization, cost optimization, security, reliability, Linux server operations and automation, working with Terraform-managed environments. Carries team-lead responsibilities alongside technical architecture work.",
  },
  {
    company: "Accenture",
    role: "Cloud Support Senior Analyst",
    period: "June 2016 – April 2021",
    description:
      "Worked on Azure cloud services, Linux infrastructure, production operations, high availability and infrastructure security.",
  },
  {
    company: "Hewlett Packard Enterprise",
    role: "Application Support Engineer",
    period: "September 2014 – June 2016",
    description:
      "Supported application and database environments, focusing on production support, troubleshooting and service reliability.",
  },
];

const certifications = [
  { name: "Azure Administrator Associate", code: "AZ-104", level: "Associate" },
  { name: "Azure Solutions Architect Expert", code: "AZ-305", level: "Expert" },
  { name: "DevOps Engineer Expert", code: "AZ-400", level: "Expert" },
];

const skillGroups = [
  { title: "Azure & cloud", items: ["Microsoft Azure", "Architecture & modernization", "FinOps & cost optimization", "High availability", "Backup & recovery", "Azure PaaS"] },
  { title: "Linux & systems", items: ["Linux administration", "Production troubleshooting", "Patching & remediation", "SSH & access", "TLS & certificates", "Identity integration"] },
  { title: "Platform & DevOps", items: ["Azure DevOps", "CI/CD pipelines", "Terraform", "Packer", "Kubernetes", "Automation"] },
];

const growingAreas = ["AI agents", "GitHub Copilot", "GitOps", "AWS fundamentals"];
---

<BaseLayout
  title="About | Prashant Hegde"
  description="Prashant Hegde is a hands-on Azure cloud and platform architect with strong Linux expertise, working across architecture, FinOps, security, reliability and automation for 50+ enterprise applications."
  active="about"
>
  <PageHero
    eyebrow="About me"
    title="Hands-on Azure architect."
    accent="Lab tinkerer and photographer after hours."
  >
    <div class="intro">
      <p class="lead">
        I'm Prashant Hegde, a cloud and platform architect with 13+ years in
        cloud and infrastructure. Azure and Linux are my core strengths, and I
        currently support 50+ enterprise applications across architecture,
        cost, security, reliability and automation.
      </p>
      <p class="lead">
        My work is mostly production: reviewing spend and utilization, closing
        vulnerabilities, strengthening availability and standardising
        pipelines. I enjoy digging into complex environments and turning
        findings into recommendations teams can act on.
      </p>
    </div>
  </PageHero>

  <section class="container stats reveal">
    {stats.map((s) => (
      <div class="stat">
        <strong class:list={{ "grad-text": s.primary }}>{s.value}</strong>
        <span>{s.label}</span>
      </div>
    ))}
  </section>

  <section class="section container">
    <SectionHeading eyebrow="Career journey" title="Experience" />
    <ol class="timeline">
      {experience.map((item, i) => (
        <li class="timeline-item reveal" style={`--d:${i}`}>
          <span class:list={["dot", { current: item.current }]} aria-hidden="true"></span>
          <div class="card is-interactive">
            <div class="row">
              <h3>{item.company}</h3>
              <span class="period">{item.period}</span>
            </div>
            <p class="role">{item.role}</p>
            <p>{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section container">
    <SectionHeading
      eyebrow="Technical background"
      title="What I work with"
      description="Azure and Linux are the core of the work."
    />
    <div class="card-grid cols-3">
      {skillGroups.map((group, i) => (
        <div class="card reveal" style={`--d:${i}`}>
          <h3>{group.title}</h3>
          <div class="tags first">
            {group.items.map((item) => <span class="tag">{item}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section container">
    <SectionHeading
      eyebrow="Beyond architecture"
      title="Technical leadership and delivery"
    />
    <div class="card leadership reveal">
      <p>
        Alongside hands-on architecture, I've increasingly taken on technical
        leadership and team responsibilities. I've completed Delivery Manager
        training and currently support team leadership and delivery
        activities while remaining closely involved in engineering and
        architecture.
      </p>
    </div>
  </section>

  <section class="section container">
    <div class="exploring reveal">
      <h3>Currently exploring</h3>
      <p>Areas I'm building up alongside the day job.</p>
      <div class="tags">
        {growingAreas.map((area) => <span class="tag outline">{area}</span>)}
      </div>
    </div>
  </section>

  <section class="section container">
    <SectionHeading eyebrow="Credentials" title="Certifications" />
    <div class="card-grid cols-3">
      {certifications.map((cert, i) => (
        <div class="card reveal" style={`--d:${i}`}>
          <span class="pill pill-live cert-level">{cert.level}</span>
          <h3>Microsoft Certified:<br />{cert.name}</h3>
          <p class="code">{cert.code}</p>
        </div>
      ))}
    </div>
    <p class="aws-cert reveal">
      Additional: <strong>AWS Certified SysOps Administrator – Associate</strong>
    </p>
  </section>

  <section class="container">
    <div class="next reveal">
      <p class="eyebrow">Outside work</p>
      <h2>Still learning, still tinkering.</h2>
      <p>
        I like understanding how things run. At home that means breaking and
        rebuilding a Kubernetes lab, and photographing landscapes, wildlife
        and travel moments as an amateur.
      </p>
      <a class="btn btn-primary" href="/contact/">Get in touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: 6px;
    max-width: 760px;
    margin-top: 24px;
  }

  .intro .lead {
    margin: 0 0 14px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 32px 36px;
  }

  .stat + .stat {
    border-left: 1px solid var(--border);
  }

  .stat strong {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.6vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .stat span {
    color: var(--muted);
    font-size: 0.86rem;
  }

  /* Timeline */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 34px;
    position: relative;
    display: grid;
    gap: 20px;
    max-width: 900px;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: linear-gradient(to bottom, var(--accent), var(--border));
  }

  .timeline-item {
    position: relative;
  }

  .dot {
    position: absolute;
    left: -34px;
    top: 30px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .dot.current {
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft);
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 16px;
  }

  .row h3 {
    margin: 0;
    font-size: 1.3rem;
  }

  .period {
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .role {
    color: var(--accent) !important;
    font-weight: 600;
    margin: 4px 0 12px !important;
  }

  /* Skills */
  .tags.first {
    margin-top: 6px;
    padding-top: 12px;
  }

  .tag.outline {
    background: transparent;
    border: 1px solid var(--border-strong);
    color: var(--muted);
  }

  .exploring {
    padding: 30px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
  }

  .exploring h3 {
    font-size: 1.15rem;
    margin-bottom: 6px;
  }

  .exploring p {
    color: var(--muted);
    margin: 0;
  }

  /* Certifications */
  .cert-level {
    align-self: flex-start;
    margin-bottom: 16px;
  }

  .code {
    margin-top: 12px !important;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--subtle) !important;
  }

  .card h3 {
    font-size: 1.1rem;
  }

  .aws-cert {
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .aws-cert strong {
    color: var(--text);
    font-weight: 600;
  }

  /* Next */
  .next {
    margin-top: 56px;
    padding: 64px 40px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
  }

  .next h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    max-width: 20ch;
  }

  .next p:not(.eyebrow) {
    color: var(--muted);
    max-width: 640px;
    margin: 16px 0 26px;
  }

  .leadership {
    max-width: 760px;
    gap: 12px;
  }

  .leadership p {
    margin: 0;
  }

  @media (max-width: 680px) {
    .stats {
      grid-template-columns: 1fr;
    }
    .stat + .stat {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
    .timeline {
      padding-left: 28px;
    }
    .dot {
      left: -28px;
    }
    .next {
      padding: 36px 24px;
    }
    .stat {
      padding: 18px;
    }
  }
</style>
