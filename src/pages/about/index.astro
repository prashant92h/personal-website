---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { stats } from "../../data/projects";

const experience = [
  {
    company: "IBM",
    role: "Senior Advisory Consultant",
    period: "May 2021 – Present",
    current: true,
    description:
      "Providing cloud architecture guidance and technical recommendations to application teams across infrastructure design, Azure services, security, automation and cost optimization. Contributing to architectural decisions and initiatives that improve scalability, operational efficiency and cloud governance.",
  },
  {
    company: "Accenture",
    role: "Cloud Support Senior Analyst",
    period: "June 2016 – April 2021",
    description:
      "Worked on Azure cloud services, Linux infrastructure, production operations, high availability and infrastructure security.",
  },
  {
    company: "Hewlett Packard Enterprise",
    role: "Application Support Engineer",
    period: "September 2014 – June 2016",
    description:
      "Supported application and database environments, focusing on production support, troubleshooting and service reliability.",
  },
];

const certifications = [
  { name: "Azure Administrator Associate", code: "AZ-104", level: "Associate" },
  { name: "Azure Solutions Architect Expert", code: "AZ-305", level: "Expert" },
  { name: "DevOps Engineer Expert", code: "AZ-400", level: "Expert" },
];

const skillGroups = [
  { title: "Cloud & Architecture", items: ["Microsoft Azure", "Azure PaaS", "Cloud Architecture", "Cost Optimization", "Cloud Security"] },
  { title: "Automation & Delivery", items: ["Terraform", "Azure DevOps", "Packer", "CI/CD", "Infrastructure Automation"] },
  { title: "Systems", items: ["Linux Administration"] },
];

const exploringAreas = [
  "Kubernetes",
  "AWS",
  "GitOps",
  "Platform Engineering",
  "AI Infrastructure",
  "Agentic Automation",
];
---

<BaseLayout
  title="About | Prashant Hegde"
  description="Learn about Prashant Hegde, a cloud professional with 13+ years of experience in cloud infrastructure, architecture, operations and automation."
  active="about"
>
  <PageHero
    eyebrow="About me"
    title="Cloud professional."
    accent="Curious about what comes next."
  >
    <div class="intro">
      <p class="lead">
        I'm Prashant Hegde, a technology professional with 13+ years of
        experience across cloud infrastructure, operations and automation.
        My work focuses on helping teams make better infrastructure
        decisions, improve operational efficiency and build reliable cloud
        environments.
      </p>
      <p class="lead">
        Over the years I've worked across infrastructure operations, cloud
        platforms, automation, security and cost optimization. I enjoy
        understanding complex environments, identifying opportunities for
        improvement and translating technical challenges into practical
        recommendations.
      </p>
    </div>
  </PageHero>

  <section class="container stats reveal">
    {stats.map((s) => (
      <div class="stat">
        <strong class="grad-text">{s.value}</strong>
        <span>{s.label}</span>
      </div>
    ))}
  </section>

  <section class="section container">
    <SectionHeading eyebrow="Career journey" title="Experience" />
    <ol class="timeline">
      {experience.map((item, i) => (
        <li class="timeline-item reveal" style={`--d:${i}`}>
          <span class:list={["dot", { current: item.current }]} aria-hidden="true"></span>
          <div class="card is-interactive">
            <div class="row">
              <h3>{item.company}</h3>
              <span class="period">{item.period}</span>
            </div>
            <p class="role">{item.role}</p>
            <p>{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section container">
    <SectionHeading
      eyebrow="Technical background"
      title="Areas of experience"
      description="Technologies and disciplines from my professional work."
    />
    <div class="card-grid cols-3">
      {skillGroups.map((group, i) => (
        <div class="card reveal" style={`--d:${i}`}>
          <h3>{group.title}</h3>
          <div class="tags first">
            {group.items.map((item) => <span class="tag">{item}</span>)}
          </div>
        </div>
      ))}
    </div>

    <div class="exploring reveal">
      <h3>Currently exploring</h3>
      <p>Technologies and practices I'm developing through hands-on learning and personal projects.</p>
      <div class="tags">
        {exploringAreas.map((area) => <span class="tag outline">{area}</span>)}
      </div>
    </div>
  </section>

  <section class="section container">
    <SectionHeading eyebrow="Certifications" title="Professional certifications" />
    <div class="card-grid cols-3">
      {certifications.map((cert, i) => (
        <div class="card reveal" style={`--d:${i}`}>
          <span class="pill pill-live cert-level">{cert.level}</span>
          <h3>Microsoft Certified:<br />{cert.name}</h3>
          <p class="code">{cert.code}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container">
    <div class="next reveal">
      <p class="eyebrow">What's next</p>
      <h2>Continuously learning and exploring.</h2>
      <p>
        I'm expanding my focus beyond traditional cloud operations towards
        cloud architecture, platform engineering and AI infrastructure —
        exploring Kubernetes, AWS, GitOps and AI-assisted automation, and
        applying them to practical infrastructure and operations challenges.
      </p>
      <a class="btn btn-primary" href="/contact/">Get in touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: 6px;
    max-width: 760px;
    margin-top: 24px;
  }

  .intro .lead {
    margin: 0 0 14px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 26px 28px;
  }

  .stat + .stat {
    border-left: 1px solid var(--border);
  }

  .stat strong {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .stat span {
    color: var(--muted);
    font-size: 0.86rem;
  }

  /* Timeline */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 34px;
    position: relative;
    display: grid;
    gap: 20px;
    max-width: 900px;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: linear-gradient(to bottom, var(--accent), var(--border));
  }

  .timeline-item {
    position: relative;
  }

  .dot {
    position: absolute;
    left: -34px;
    top: 30px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .dot.current {
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft);
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 16px;
  }

  .row h3 {
    margin: 0;
    font-size: 1.3rem;
  }

  .period {
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .role {
    color: var(--accent) !important;
    font-weight: 600;
    margin: 4px 0 12px !important;
  }

  /* Skills */
  .tags.first {
    margin-top: 6px;
    padding-top: 12px;
  }

  .tag.outline {
    background: transparent;
    border: 1px solid var(--border-strong);
    color: var(--muted);
  }

  .exploring {
    margin-top: 28px;
    padding: 30px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
  }

  .exploring h3 {
    font-size: 1.15rem;
    margin-bottom: 6px;
  }

  .exploring p {
    color: var(--muted);
    margin: 0;
  }

  /* Certifications */
  .cert-level {
    align-self: flex-start;
    margin-bottom: 16px;
  }

  .code {
    margin-top: 12px !important;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--subtle) !important;
  }

  .card h3 {
    font-size: 1.1rem;
  }

  /* Next */
  .next {
    margin-top: 72px;
    padding: 56px 40px;
    background:
      radial-gradient(520px circle at 10% 0%, var(--glow-1), transparent 60%),
      var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
  }

  .next h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    max-width: 20ch;
  }

  .next p:not(.eyebrow) {
    color: var(--muted);
    max-width: 640px;
    margin: 16px 0 26px;
  }

  @media (max-width: 960px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .stat:nth-child(3) {
      border-left: 0;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 680px) {
    .timeline {
      padding-left: 28px;
    }
    .dot {
      left: -28px;
    }
    .next {
      padding: 36px 24px;
    }
    .stat {
      padding: 18px;
    }
  }
</style>
