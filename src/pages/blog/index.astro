---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";

const posts = (await getCollection("blog"))
  .filter(({ data }) => import.meta.env.DEV || !data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];
const otherPosts = posts.filter((post) => post.id !== featuredPost?.id);
const categories = [...new Set(posts.map((post) => post.data.category))];

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" });
---

<BaseLayout
  title="Blog | Prashant Hegde"
  description="Notes, ideas and learnings on cloud infrastructure, platform engineering, DevOps and technology."
  active="blog"
>
  <PageHero
    eyebrow="Writing"
    title="Notes, ideas"
    accent="and learnings."
    lead="Practical experiences, technical explorations and lessons from working with cloud infrastructure, platforms and technology."
  >
    <p class="rss"><a class="text-link" href="/rss.xml">Subscribe via RSS <span aria-hidden="true">→</span></a></p>
  </PageHero>

  <div class="container content">
    {featuredPost && (
      <section aria-labelledby="featured-heading" class="reveal">
        <p class="eyebrow" id="featured-heading">Featured article</p>
        <a class="card featured" href={`/blog/${featuredPost.id}/`}>
          <div class="featured-top">
            <span class="tag">{featuredPost.data.category}</span>
            {import.meta.env.DEV && featuredPost.data.draft && <span class="pill">Draft</span>}
          </div>
          <h2>{featuredPost.data.title}</h2>
          <p>{featuredPost.data.description}</p>
          <div class="meta">
            <span>{formatDate(featuredPost.data.pubDate)}</span>
            {featuredPost.data.readingTime && <span>{featuredPost.data.readingTime} min read</span>}
          </div>
          <span class="text-link">Read article <span aria-hidden="true">→</span></span>
        </a>
      </section>
    )}

    <section class="archive" aria-labelledby="archive-heading">
      <div class="archive-head">
        <div>
          <p class="eyebrow">The archive</p>
          <h2 id="archive-heading">Latest writing</h2>
        </div>
        <span class="count">{posts.length} {posts.length === 1 ? "article" : "articles"}</span>
      </div>

      {categories.length > 1 && (
        <div class="filters" role="group" aria-label="Filter by category">
          <button type="button" class="chip selected" data-cat="all">All</button>
          {categories.map((c) => <button type="button" class="chip" data-cat={c}>{c}</button>)}
        </div>
      )}

      {otherPosts.length > 0 ? (
        <div class="list">
          {otherPosts.map((post) => (
            <a class="row" href={`/blog/${post.id}/`} data-cat={post.data.category}>
              <div>
                <span class="tag">{post.data.category}</span>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <div class="meta">
                  <span>{formatDate(post.data.pubDate)}</span>
                  {post.data.readingTime && <span>{post.data.readingTime} min read</span>}
                </div>
              </div>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="card empty">
          <h3>{featuredPost ? "That's everything so far." : "More ideas are taking shape."}</h3>
          <p>New articles will appear here as they are published.</p>
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .rss {
    margin: 26px 0 0;
  }

  .content {
    padding-bottom: 40px;
  }

  .featured {
    padding: 40px;
    background:
      radial-gradient(560px circle at 100% 0%, var(--glow-1), transparent 60%),
      var(--surface);
  }

  .featured-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
  }

  .featured h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    max-width: 24ch;
  }

  .featured > p {
    max-width: 680px;
    margin-top: 14px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 20px;
    color: var(--subtle);
    font-size: 0.84rem;
  }

  .featured .text-link {
    margin-top: 22px;
  }

  .archive {
    padding-top: 72px;
  }

  .archive-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
  }

  .archive-head h2 {
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
  }

  .count {
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
  }

  .chip {
    padding: 7px 15px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 550;
    cursor: pointer;
    transition: all var(--transition);
  }

  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .chip.selected {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
    transition: padding var(--transition);
  }

  .row[hidden] {
    display: none;
  }

  .row:hover {
    padding-inline: 14px;
  }

  .row h3 {
    margin: 12px 0 8px;
    font-size: 1.3rem;
    transition: color var(--transition);
  }

  .row:hover h3 {
    color: var(--accent);
  }

  .row p {
    margin: 0;
    color: var(--muted);
    max-width: 720px;
  }

  .arrow {
    color: var(--accent);
    font-size: 1.4rem;
    transition: transform var(--transition);
  }

  .row:hover .arrow {
    transform: translateX(6px);
  }

  .empty {
    margin-top: 20px;
    padding: 36px;
  }

  @media (max-width: 680px) {
    .featured {
      padding: 26px;
    }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
  const rows = document.querySelectorAll<HTMLElement>(".row");

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const cat = chip.dataset.cat;
      chips.forEach((c) => c.classList.toggle("selected", c === chip));
      rows.forEach((row) => {
        row.hidden = cat !== "all" && row.dataset.cat !== cat;
      });
    });
  });
</script>
