
---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const allPosts = await getCollection("blog");

const posts = allPosts
  .filter(({ data }) => import.meta.env.DEV || !data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featuredPost =
  posts.find((post) => post.data.featured) ?? posts[0];

const otherPosts = posts.filter(
  (post) => post.id !== featuredPost?.id
);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-IN", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
---

<BaseLayout
  title="Blog | Prashant Hegde"
  description="Notes, ideas and learnings on cloud infrastructure, platform engineering, DevOps and technology."
  active="blog"
>
  <section class="page-intro container">
    <p class="eyebrow">WRITING</p>
    <h1>Notes, ideas<br /><span>and learnings.</span></h1>
    <p>
      Sharing practical experiences, technical explorations and lessons
      from working with cloud infrastructure, platforms and technology.
    </p>
  </section>

  <div class="container content-container">
    {featuredPost && (
      <section class="featured-section">
        <p class="eyebrow">FEATURED ARTICLE</p>

        <a class="featured-card" href={`/blog/${featuredPost.id}/`}>
          <div class="featured-content">
            <span class="category">{featuredPost.data.category}</span>
            <h2>{featuredPost.data.title}</h2>
            <p>{featuredPost.data.description}</p>

            <div class="article-meta">
              <span>{formatDate(featuredPost.data.pubDate)}</span>
              {featuredPost.data.readingTime && (
                <span>{featuredPost.data.readingTime} min read</span>
              )}
            </div>

            <span class="read-link">Read article <span aria-hidden="true">→</span></span>
          </div>
        </a>
      </section>
    )}

    <section class="articles-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">THE ARCHIVE</p>
          <h2>Latest writing</h2>
        </div>
        <span class="post-count">
          {posts.length} {posts.length === 1 ? "article" : "articles"}
        </span>
      </div>

      {otherPosts.length > 0 ? (
        <div class="article-list">
          {otherPosts.map((post) => (
            <a class="article-row" href={`/blog/${post.id}/`}>
              <div class="article-main">
                <span class="category">{post.data.category}</span>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <div class="article-meta">
                  <span>{formatDate(post.data.pubDate)}</span>
                  {post.data.readingTime && (
                    <span>{post.data.readingTime} min read</span>
                  )}
                </div>
              </div>
              <span class="article-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      ) : !featuredPost ? (
        <div class="empty-state">
          <h3>More ideas are taking shape.</h3>
          <p>New articles will appear here as they are published.</p>
        </div>
      ) : null}
    </section>
  </div>
</BaseLayout>

<style>
  .page-intro {
    padding-top: 88px;
    padding-bottom: 68px;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: 18px;
  }

  h1, h2, h3 {
    font-family: var(--font-heading);
    color: var(--color-text);
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.15;
    letter-spacing: -0.05em;
  }

  h1 span {
    color: var(--color-muted);
    font-weight: 500;
  }

  .page-intro > p:last-child {
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.8;
    max-width: 680px;
    margin-top: 22px;
  }

  .content-container {
    padding-bottom: 100px;
  }

  .featured-section {
    padding: 32px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .featured-card {
    display: block;
  }

  .category {
    display: inline-block;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .featured-content h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    letter-spacing: -0.04em;
  }

  .featured-content > p {
    color: var(--color-muted);
    line-height: 1.75;
    max-width: 700px;
    margin-top: 12px;
  }

  .article-meta {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    color: var(--color-muted);
    font-size: 0.82rem;
    margin-top: 20px;
  }

  .read-link {
    display: inline-block;
    color: var(--color-accent);
    font-weight: 600;
    margin-top: 24px;
  }

  .articles-section {
    padding-top: 76px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .section-heading h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    letter-spacing: -0.04em;
  }

  .post-count {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .article-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 26px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .article-row h3 {
    font-size: 1.2rem;
  }

  .article-row p {
    color: var(--color-muted);
    line-height: 1.7;
    margin-top: 8px;
  }

  .article-row .article-meta {
    margin-top: 12px;
  }

  .article-arrow {
    color: var(--color-accent);
    font-size: 1.3rem;
  }

  .empty-state {
    padding: 40px 0;
  }

  .empty-state p {
    color: var(--color-muted);
    margin-top: 10px;
  }

  @media (max-width: 700px) {
    .page-intro {
      padding-top: 64px;
      padding-bottom: 48px;
    }

    .featured-section {
      padding: 22px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

