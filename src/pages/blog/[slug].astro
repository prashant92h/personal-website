---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../config";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(({ data }) => import.meta.env.DEV || !data.draft)
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const words = (post.body ?? "").split(/\s+/).filter(Boolean).length;
const readingTime = post.data.readingTime ?? Math.max(1, Math.ceil(words / 220));

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" });

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { "@type": "Person", name: SITE.name, url: SITE.url },
  mainEntityOfPage: new URL(`/blog/${post.id}/`, SITE.url).href,
};
---

<BaseLayout
  title={`${post.data.title} | ${SITE.name}`}
  description={post.data.description}
  active="blog"
  type="article"
  publishedTime={post.data.pubDate}
  image={post.data.cover}
  jsonLd={articleSchema}
  noindex={post.data.draft}
>
  <div class="progress" id="progress" aria-hidden="true"></div>

  <article class="container article">
    <a class="text-link back" href="/blog/"><span aria-hidden="true" class="flip">→</span> Back to writing</a>

    <header class="article-header">
      <div class="top">
        <span class="tag">{post.data.category}</span>
        {import.meta.env.DEV && post.data.draft && <span class="pill">Draft preview</span>}
      </div>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>

      <div class="meta">
        <span>{formatDate(post.data.pubDate)}</span>
        <span>{readingTime} min read</span>
        {post.data.updatedDate && <span>Updated {formatDate(post.data.updatedDate)}</span>}
      </div>

      {post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((t) => <span class="tag outline">{t}</span>)}
        </div>
      )}
    </header>

    <div class="layout">
      <div class="prose">
        <Content />
      </div>

      {toc.length > 1 && (
        <aside class="toc" aria-label="On this page">
          <p>On this page</p>
          <ul>
            {toc.map((h) => (
              <li class:list={{ sub: h.depth === 3 }}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    <nav class="pager" aria-label="More articles">
      {newer ? (
        <a class="card" href={`/blog/${newer.id}/`}>
          <span>← Newer</span>
          <strong>{newer.data.title}</strong>
        </a>
      ) : <span></span>}
      {older ? (
        <a class="card next" href={`/blog/${older.id}/`}>
          <span>Older →</span>
          <strong>{older.data.title}</strong>
        </a>
      ) : <a class="card next" href="/blog/"><span>All articles →</span><strong>Back to the archive</strong></a>}
    </nav>
  </article>
</BaseLayout>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    height: 3px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 50%;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
  }

  .article {
    padding-block: 48px 40px;
  }

  .back {
    font-size: 0.9rem;
  }

  .flip {
    display: inline-block;
    transform: scaleX(-1);
  }

  .article-header {
    max-width: 820px;
    padding-block: 40px 36px;
    border-bottom: 1px solid var(--border);
  }

  .top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .article-header .lead {
    margin: 20px 0 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: 22px;
    color: var(--subtle);
    font-size: 0.86rem;
  }

  .tags {
    padding-top: 18px;
  }

  .tag.outline {
    background: transparent;
    border: 1px solid var(--border-strong);
    color: var(--muted);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 760px) 240px;
    justify-content: space-between;
    gap: 56px;
    padding-top: 44px;
  }

  /* Article typography */
  .prose {
    font-size: 1.06rem;
    line-height: 1.85;
    color: var(--muted);
  }

  .prose :global(h2) {
    font-size: 1.8rem;
    margin: 52px 0 16px;
    color: var(--text);
  }

  .prose :global(h3) {
    font-size: 1.3rem;
    margin: 36px 0 12px;
    color: var(--text);
  }

  .prose :global(h2 a),
  .prose :global(h3 a) {
    color: inherit;
  }

  .prose :global(p) {
    margin: 0 0 22px;
  }

  .prose :global(strong) {
    color: var(--text);
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 24px;
    margin: 0 0 24px;
  }

  .prose :global(li) {
    margin-bottom: 8px;
  }

  .prose :global(li::marker) {
    color: var(--accent);
  }

  .prose :global(blockquote) {
    margin: 28px 0;
    padding: 6px 0 6px 22px;
    border-left: 3px solid var(--accent);
    color: var(--text);
    font-size: 1.12rem;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 2px 7px;
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 22px;
    margin: 28px 0;
    background: var(--code-bg) !important;
    color: var(--code-text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    line-height: 1.7;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
    color: inherit;
    font-size: 0.88rem;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 44px 0;
  }

  .prose :global(img) {
    border-radius: var(--radius-md);
    margin: 28px 0;
  }

  /* TOC */
  .toc {
    position: sticky;
    top: calc(var(--header-h) + 28px);
    align-self: start;
    padding-left: 20px;
    border-left: 1px solid var(--border);
  }

  .toc p {
    margin: 0 0 12px;
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }

  .toc li.sub {
    padding-left: 12px;
  }

  .toc a {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.4;
    transition: color var(--transition);
  }

  .toc a:hover {
    color: var(--accent);
  }

  /* Pager */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 72px;
  }

  .pager .card {
    gap: 6px;
  }

  .pager .card span {
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .pager strong {
    font-family: var(--font-heading);
    font-size: 1.05rem;
  }

  .pager .next {
    text-align: right;
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .toc {
      display: none;
    }
  }

  @media (max-width: 680px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .next {
      text-align: left;
    }
  }
</style>

<script>
  const bar = document.getElementById("progress");
  const update = () => {
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    const ratio = max > 0 ? Math.min(1, window.scrollY / max) : 0;
    if (bar) bar.style.transform = `scaleX(${ratio})`;
  };
  update();
  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
</script>
