---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { SITE } from "../../config";

const contactLinks = [
  {
    title: "LinkedIn",
    description: "Connect with me professionally and follow my work.",
    label: "Visit LinkedIn",
    href: SITE.social.linkedin,
    icon: "M4 4h4v16H4zM10 9h4v2c.6-1.2 2-2.2 4-2.2 3 0 4 2 4 5V20h-4v-5.5c0-1.6-.6-2.5-2-2.5s-2 1-2 2.5V20h-4zM6 1.5a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4",
  },
  {
    title: "GitHub",
    description: "Explore my projects, code and technical experiments.",
    label: "View GitHub",
    href: SITE.social.github,
    icon: "M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21",
  },
];
---

<BaseLayout
  title="Contact | Prashant Hegde"
  description="Get in touch with Prashant Hegde to talk Azure operations, DevOps, home labs or photography."
  active="contact"
>
  <PageHero
    eyebrow="Get in touch"
    title="Let's compare"
    accent="notes."
    lead="Happy to talk Azure, Linux, cost optimization, security and reliability, DevOps pipelines, home-lab tinkering or photography."
  />

  <section class="container contact">
    <div class="card-grid cols-2 grid-narrow">
      {contactLinks.map((link, i) => (
        <a class="card reveal" href={link.href} target="_blank" rel="noopener noreferrer" style={`--d:${i}`}>
          <span class="icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d={link.icon}></path>
            </svg>
          </span>
          <h2>{link.title}</h2>
          <p>{link.description}</p>
          <span class="text-link go">{link.label} <span aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .grid-narrow {
    max-width: 880px;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-bottom: 20px;
    border-radius: var(--radius-md);
    background: var(--accent-soft);
    color: var(--accent);
  }

  h2 {
    font-size: 1.4rem;
    margin-bottom: 10px;
  }

  .go {
    margin-top: 28px;
  }
</style>
