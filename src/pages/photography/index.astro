---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { photographs, photoCategories, photographyOgImage } from "../../data/photos";

const hasPhotos = photographs.length > 0;
---

<BaseLayout
  title="Photography | Prashant Hegde"
  description="Photographs by Prashant Hegde, an amateur photographer — landscapes, nature, wildlife and travel."
  active="photography"
  image={photographyOgImage}
>
  <PageHero
    eyebrow="Photography"
    title="An amateur's eye"
    accent="beyond the data centre."
    lead="I'm not a pro — just someone who enjoys the hunt for good light. Landscapes, nature, wildlife and travel moments, shared as I learn."
  />

  <section class="container gallery-section">
    {hasPhotos ? (
      <>
        <div class="filters" role="group" aria-label="Filter photographs by category">
          <button type="button" class="chip selected" data-cat="all" aria-pressed="true">All</button>
          {photoCategories.map((c) => <button type="button" class="chip" data-cat={c} aria-pressed="false">{c}</button>)}
        </div>
        <div class="masonry" id="gallery">
          {photographs.map((photo, i) => (
            <figure class="photo" data-cat={photo.category} data-index={i}>
              <button type="button" class="photo-btn" aria-label={`View ${photo.title} full size`}>
                <img
                  src={photo.image}
                  alt={photo.alt}
                  width={photo.width}
                  height={photo.height}
                  loading="lazy"
                  decoding="async"
                />
              </button>
              <figcaption>
                <strong>{photo.title}</strong>
                <span>{photo.location ?? photo.category}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </>
    ) : (
      <div class="coming reveal">
        <h2>Collection in progress.</h2>
        <p>
          I'm curating a small selection of my favourite landscapes, wildlife
          and travel photographs. The gallery will appear here as I put the
          collection together.
        </p>
      </div>
    )}
  </section>

  {hasPhotos && (
    <dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
      <button type="button" class="lb-close" aria-label="Close viewer">×</button>
      <button type="button" class="lb-nav prev" aria-label="Previous photo">‹</button>
      <figure>
        <img id="lb-img" alt="" />
        <figcaption id="lb-cap"></figcaption>
      </figure>
      <button type="button" class="lb-nav next" aria-label="Next photo">›</button>
    </dialog>
  )}
</BaseLayout>

<style>
  .gallery-section {
    padding-bottom: 40px;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 28px;
  }

  .chip {
    padding: 8px 16px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 550;
    cursor: pointer;
    transition: all var(--transition);
  }

  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .chip.selected {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .masonry {
    columns: 3;
    column-gap: 18px;
  }

  .photo {
    break-inside: avoid;
    margin: 0 0 18px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .photo[hidden] {
    display: none;
  }

  .photo-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }

  .photo-btn img {
    width: 100%;
    height: auto;
    transition: transform 500ms var(--ease);
  }

  .photo:hover .photo-btn img {
    transform: scale(1.04);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px 14px;
  }

  figcaption strong {
    font-family: var(--font-heading);
    font-size: 0.95rem;
  }

  figcaption span {
    color: var(--subtle);
    font-size: 0.8rem;
  }

  /* Empty state: one contained message, no fake thumbnails */
  .coming {
    max-width: 640px;
    padding: 40px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
  }

  .coming h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .coming p {
    margin: 14px 0 0;
    color: var(--muted);
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 24px;
    border: 0;
    background: rgba(4, 10, 7, 0.92);
    color: #e8f2ec;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox::backdrop {
    background: rgba(4, 10, 7, 0.7);
  }

  .lightbox figure {
    margin: 0;
    max-width: min(1100px, 100%);
    text-align: center;
  }

  .lightbox img {
    max-height: calc(100dvh - 140px);
    width: auto;
    margin-inline: auto;
    border-radius: var(--radius-md);
  }

  .lightbox figcaption {
    padding: 14px 0 0;
    align-items: center;
    color: #e8f2ec;
  }

  .lightbox figcaption span {
    color: #9db3a7;
  }

  .lb-close,
  .lb-nav {
    position: absolute;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    transition: background var(--transition);
  }

  .lb-close:hover,
  .lb-nav:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .lb-close {
    top: 18px;
    right: 18px;
  }

  .lb-nav {
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-nav.prev {
    left: 18px;
  }

  .lb-nav.next {
    right: 18px;
  }

  @media (max-width: 860px) {
    .masonry {
      columns: 2;
    }

  }

  @media (max-width: 520px) {
    .masonry {
      columns: 1;
    }

    .lb-nav {
      top: auto;
      bottom: 20px;
      transform: none;
    }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
  const photos = Array.from(document.querySelectorAll<HTMLElement>(".photo"));

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const cat = chip.dataset.cat;
      chips.forEach((c) => {
        c.classList.toggle("selected", c === chip);
        c.setAttribute("aria-pressed", String(c === chip));
      });
      photos.forEach((p) => {
        p.hidden = cat !== "all" && p.dataset.cat !== cat;
      });
    });
  });

  const box = document.getElementById("lightbox") as HTMLDialogElement | null;
  const img = document.getElementById("lb-img") as HTMLImageElement | null;
  const cap = document.getElementById("lb-cap");

  if (box && img && cap && photos.length > 0) {
    let current = 0;
    const visible = () => photos.filter((p) => !p.hidden);

    const show = (el: HTMLElement) => {
      const source = el.querySelector("img");
      const title = el.querySelector("strong")?.textContent ?? "";
      const sub = el.querySelector("figcaption span")?.textContent ?? "";
      if (!source) return;
      img.src = source.currentSrc || source.src;
      img.alt = source.alt;
      cap.replaceChildren();
      const strong = document.createElement("strong");
      strong.textContent = title;
      const span = document.createElement("span");
      span.textContent = sub;
      cap.append(strong, span);
    };

    const step = (dir: number) => {
      const list = visible();
      if (list.length === 0) return;
      current = (current + dir + list.length) % list.length;
      show(list[current]);
    };

    photos.forEach((p) => {
      p.querySelector("button")?.addEventListener("click", () => {
        const list = visible();
        current = Math.max(0, list.indexOf(p));
        show(p);
        box.showModal();
      });
    });

    box.querySelector(".lb-close")?.addEventListener("click", () => box.close());
    box.querySelector(".prev")?.addEventListener("click", () => step(-1));
    box.querySelector(".next")?.addEventListener("click", () => step(1));
    box.addEventListener("click", (e) => {
      if (e.target === box) box.close();
    });
    box.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
    });
  }
</script>
