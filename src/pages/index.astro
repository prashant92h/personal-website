---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { SITE } from "../config";
import { capabilities, impact, exploring, stats } from "../data/projects";

const posts = (await getCollection("blog"))
  .filter(({ data }) => import.meta.env.DEV || !data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" });
---

<BaseLayout title={`${SITE.name} | ${SITE.tagline}`} description={SITE.description}>
  <section class="hero">
    <div class="aurora" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Azure · Linux · Platform Engineering · FinOps</p>
        <h1>
          Hi, I'm Prashant.
          <span class="grad-text">I solve infrastructure problems on Azure.</span>
        </h1>
        <p class="lead">
          Cloud and platform architect working across Azure, Linux, DevOps,
          security and FinOps for 50+ enterprise applications. I focus on
          practical architecture: modernizing platforms, solving production
          problems, improving resilience and automating operations.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/projects/">View my work</a>
          <a class="btn btn-ghost" href="/about/">About me</a>
        </div>
      </div>

      <div class="terminal" aria-hidden="true">
        <div class="terminal-bar">
          <span></span><span></span><span></span>
          <em>~/prashant</em>
        </div>
        <div class="term">
          <p class="ln"><span class="c-muted">$</span> whoami</p>
          <p class="ln c-acc">prashant-hegde</p>

          <p class="ln gap"><span class="c-muted">$</span> cat focus.txt</p>
          <p class="ln"><span class="c-acc">▸</span> Azure · Linux · Platform engineering</p>
          <p class="ln"><span class="c-acc">▸</span> FinOps · Security · Reliability</p>
          <p class="ln"><span class="c-acc">▸</span> Kubernetes · DevOps · Automation</p>

          <p class="ln gap"><span class="c-muted">$</span> cat exploring.txt</p>
          <p class="ln"><span class="c-acc">▸</span> AI agents · GitHub Copilot · AWS</p>

          <p class="ln gap"><span class="c-muted">$</span> cat after-hours.txt</p>
          <p class="ln"><span class="c-acc">▸</span> K3s lab · photography</p>

          <p class="ln gap"><span class="c-muted">$</span> <span class="caret"></span></p>
        </div>
      </div>
    </div>
  </section>

  <section class="container stats reveal">
    {stats.map((s) => (
      <div class="stat">
        <strong class:list={{ "grad-text": s.primary }}>{s.value}</strong>
        <span>{s.label}</span>
      </div>
    ))}
  </section>

  <section class="section container">
    <SectionHeading
      eyebrow="What I do"
      title="Architecture that works beyond go-live."
      description="I help teams evolve production Azure environments, improving architecture, reliability, security and cost while solving the operational challenges that appear long after deployment."
    />
    <div class="card-grid cols-4">
      {capabilities.map((item, i) => (
        <div class="card reveal" style={`--d:${i}`}>
          <span class="icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d={item.icon}></path>
            </svg>
          </span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section container">
    <SectionHeading eyebrow="Selected work" title="Measurable engineering outcomes">
      <a class="text-link" href="/projects/">View all <span aria-hidden="true">→</span></a>
    </SectionHeading>
    <ol class="work">
      {impact.map((p, i) => (
        <li class="reveal" style={`--d:${i}`}>
          <a class="work-row" href="/projects/">
            <div class="work-num">
              <strong class:list={{ "grad-text": p.primary }}>{p.value}</strong>
              <span>{p.label}</span>
            </div>
            <div class="work-body">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
            <span class="work-go">View work <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="exploring-band">
    <div class="container exploring reveal">
      <p class="eyebrow">What I'm exploring</p>
      <h2>{exploring.title}</h2>
      <p class="exploring-text">{exploring.text}</p>
      <div class="tags">
        {exploring.tags.map((t) => <span class="tag outline">{t}</span>)}
      </div>
      {exploring.href && (
        <a class="text-link link" href={exploring.href}>See the project <span aria-hidden="true">→</span></a>
      )}
    </div>
  </section>

  <section class="section container">
    <a class="lab-banner reveal" href="/lab/">
      <div>
        <p class="eyebrow">The lab</p>
        <h2>Where I tinker: a Kubernetes home lab.</h2>
        <p>
          A hobby K3s cluster for self-hosted services and experiments —
          the place I try things I don't get to touch at work, and write down
          what breaks.
        </p>
        <span class="text-link">Explore the lab <span aria-hidden="true">→</span></span>
      </div>
      <div class="lab-art" aria-hidden="true">
        <svg viewBox="0 0 220 160" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="82" y="8" width="56" height="30" rx="7"></rect>
          <rect x="12" y="104" width="56" height="30" rx="7"></rect>
          <rect x="82" y="104" width="56" height="30" rx="7"></rect>
          <rect x="152" y="104" width="56" height="30" rx="7"></rect>
          <path d="M110 38v32M40 104V70h140v34M110 70v34" stroke-linecap="round"></path>
          <circle cx="110" cy="23" r="3" fill="currentColor"></circle>
          <circle cx="40" cy="119" r="3" fill="currentColor"></circle>
          <circle cx="110" cy="119" r="3" fill="currentColor"></circle>
          <circle cx="180" cy="119" r="3" fill="currentColor"></circle>
        </svg>
      </div>
    </a>
  </section>

  {posts.length > 0 && (
    <section class="section container">
      <SectionHeading eyebrow="Latest writing" title="Notes from the field and the lab">
        <a class="text-link" href="/blog/">All articles <span aria-hidden="true">→</span></a>
      </SectionHeading>
      <div class="card-grid cols-3">
        {posts.map((post, i) => (
          <a class="card reveal" href={`/blog/${post.id}/`} style={`--d:${i}`}>
            <span class="tag self-start">{post.data.category}</span>
            <h3 class="post-title">{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="meta">{formatDate(post.data.pubDate)}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="section container">
    <div class="cta-panel reveal">
      <h2>Want to compare notes?</h2>
      <p>Happy to talk Azure, Linux, platform engineering, FinOps, home labs or photography.</p>
      <div class="hero-actions center">
        <a class="btn btn-primary" href="/contact/">Let's connect</a>
        <a class="btn btn-ghost" href="/photography/">See my photography</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: 96px 56px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 64px;
    align-items: center;
  }

  .hero .eyebrow {
    color: var(--muted);
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  h1 span {
    display: block;
    margin-top: 6px;
  }

  .hero-copy .lead {
    max-width: 560px;
    margin: 28px 0 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
  }

  .hero-actions.center {
    justify-content: center;
  }

  /* Terminal */
  .terminal {
    min-width: 0;
    background: var(--code-bg);
    color: var(--code-text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .terminal-bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
  }

  .terminal-bar em {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-style: normal;
    color: rgba(255, 255, 255, 0.5);
  }

  .term {
    padding: 22px 22px 24px;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    line-height: 1.8;
    overflow-x: auto;
  }

  /* Every terminal line is its own block so the final prompt sits on a new line */
  .term .ln {
    display: block;
    margin: 0;
    white-space: pre;
  }

  .term .gap {
    margin-top: 1em;
  }

  .c-muted {
    color: #7d968a;
  }

  .c-acc {
    color: #34d399;
  }

  .caret {
    display: inline-block;
    width: 8px;
    height: 1em;
    vertical-align: text-bottom;
    background: #34d399;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 36px 40px;
  }

  .stat + .stat {
    border-left: 1px solid var(--border);
  }

  .stat strong {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .stat span {
    color: var(--muted);
    font-size: 0.92rem;
  }

  /* Capability cards */
  .icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 20px;
    border-radius: var(--radius-md);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .card h3 {
    font-size: 1.15rem;
  }

  /* Selected work: editorial rows */
  .work {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--border);
  }

  .work li {
    border-top: 1px solid var(--border);
  }

  .work-row {
    display: grid;
    grid-template-columns: 240px 1fr auto;
    gap: 40px;
    align-items: center;
    padding: 36px 8px;
    transition: background var(--transition);
  }

  .work-row:hover {
    background: var(--accent-soft);
  }

  .work-num {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .work-num strong {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .work-num span {
    color: var(--subtle);
    font-size: 0.8rem;
  }

  .work-body h3 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .work-body p {
    margin: 0;
    max-width: 520px;
    color: var(--muted);
  }

  .work-go {
    display: inline-flex;
    gap: 6px;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 600;
    white-space: nowrap;
    transition: color var(--transition);
  }

  .work-go span {
    transition: transform var(--transition);
  }

  .work-row:hover .work-go {
    color: var(--accent);
  }

  .work-row:hover .work-go span {
    transform: translateX(3px);
  }

  /* Exploring: subtle tinted full-width band */
  .exploring-band {
    margin-block: 56px;
    padding-block: 72px;
    background: var(--accent-soft);
    border-block: 1px solid color-mix(in srgb, var(--accent) 18%, var(--border));
  }

  .exploring {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .exploring h2 {
    font-size: clamp(1.8rem, 3.4vw, 2.4rem);
    line-height: 1.12;
  }

  .exploring-text {
    max-width: 680px;
    margin: 18px 0 0;
    color: var(--muted);
  }

  .exploring .tags {
    margin-top: 0;
    padding-top: 28px;
  }

  .tag.outline {
    background: transparent;
    border: 1px solid var(--border-strong);
    color: var(--muted);
  }

  .exploring .link {
    margin-top: 24px;
  }

  /* Writing cards (shown once an article is published) */
  .self-start {
    align-self: flex-start;
    margin-bottom: 16px;
  }

  .post-title {
    font-size: 1.15rem;
  }

  .meta {
    margin-top: auto;
    padding-top: 20px;
    color: var(--subtle);
    font-size: 0.82rem;
  }

  /* Lab banner */
  .lab-banner {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 32px;
    align-items: center;
    padding: 56px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    transition: border-color var(--transition);
  }

  .lab-banner:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }

  .lab-banner h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    line-height: 1.12;
    max-width: 22ch;
  }

  .lab-banner p:not(.eyebrow) {
    color: var(--muted);
    max-width: 520px;
    margin: 18px 0 24px;
  }

  .lab-art {
    color: var(--accent);
    justify-self: center;
    width: min(100%, 260px);
    opacity: 0.85;
  }

  /* CTA */
  .cta-panel {
    padding: 72px 28px;
    text-align: center;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
  }

  .cta-panel h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.1;
  }

  .cta-panel p {
    color: var(--muted);
    margin: 16px 0 0;
  }

  @media (max-width: 960px) {
    .hero {
      padding-block: 72px 40px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .terminal {
      max-width: 520px;
    }

    .stat {
      padding: 28px 24px;
    }

    .work-row {
      grid-template-columns: 180px 1fr auto;
      gap: 28px;
    }

    .exploring-band {
      margin-block: 40px;
      padding-block: 56px;
    }

    .lab-banner {
      padding: 40px;
    }
  }

  @media (max-width: 680px) {
    .hero {
      padding-block: 48px 32px;
    }

    .hero .eyebrow {
      letter-spacing: 0.08em;
      font-size: 0.7rem;
    }

    .term {
      padding: 18px;
      font-size: 0.8rem;
    }

    .stats {
      grid-template-columns: 1fr;
    }

    .stat {
      padding: 22px;
    }

    .stat + .stat {
      border-left: 0;
      border-top: 1px solid var(--border);
    }

    .work-row {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 28px 4px;
    }

    .work-go {
      display: none;
    }

    .exploring-band {
      margin-block: 32px;
      padding-block: 44px;
    }

    .lab-banner {
      grid-template-columns: 1fr;
      padding: 28px;
    }

    .lab-art {
      display: none;
    }

    .cta-panel {
      padding: 48px 20px;
    }
  }
</style>
