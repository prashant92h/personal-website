---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    title: "Kubernetes Home Lab",
    description:
      "Building a self-hosted environment with K3s, GitOps and persistent workloads.",
    href: "/projects/",
    label: "Personal project",
  },
  {
    title: "Cloud Infrastructure Automation",
    description:
      "Exploring infrastructure as code, automation and repeatable cloud operations.",
    href: "/projects/",
    label: "Cloud engineering",
  },
  {
    title: "Cloud Cost Optimization",
    description:
      "Practical approaches to improving cloud resource efficiency and operational costs.",
    href: "/projects/",
    label: "Cloud operations",
  },
];
---

<BaseLayout
  title="Prashant Hegde | Cloud & Platform Engineering"
  description="Prashant Hegde — 13+ years of experience in cloud infrastructure, automation and platform engineering."
  active="home"
>
<section class="hero container">
  <p class="eyebrow">CLOUD · AUTOMATION · PLATFORM ENGINEERING</p>

  <h1>
    Hi, I'm Prashant Hegde.
    <span>Cloud &amp; Platform Engineering.</span>
  </h1>

  <p class="hero-description">
    With 13+ years of experience across cloud infrastructure, operations
    and automation, I'm exploring cloud architecture, platform engineering
    and AI infrastructure.
  </p>

  <div class="hero-links">
    <a class="button button-primary" href="/projects/">Explore projects</a>
    <a class="text-link" href="/about/">More about me <span aria-hidden="true">→</span></a>
  </div>
</section>

  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">SELECTED WORK</p>
        <h2>Projects & explorations</h2>
      </div>
      <a class="text-link" href="/projects/">View all <span aria-hidden="true">→</span></a>
    </div>

    <div class="project-grid">
      {projects.map((project) => (
        <a class="project-card" href={project.href}>
          <span class="project-label">{project.label}</span>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <span class="card-link">Explore <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="section container secondary-section">
    <div>
      <p class="eyebrow">WRITING</p>
      <h2>Notes, ideas and learnings.</h2>
      <p>
        Sharing practical experiences, technical explorations and things
        I'm learning along the way.
      </p>
    </div>
    <a class="button button-secondary" href="/blog/">Explore the blog</a>
  </section>

  <section class="section container secondary-section">
    <div>
      <p class="eyebrow">PHOTOGRAPHY</p>
      <h2>Perspectives beyond technology.</h2>
      <p>
        A collection of moments from travel, nature and everyday life.
      </p>
    </div>
    <a class="button button-secondary" href="/photography/">View photographs</a>
  </section>

  <section class="section container contact-section">
    <p class="eyebrow">GET IN TOUCH</p>
    <h2>Have something interesting in mind?</h2>
    <p>I'm always open to meaningful conversations and collaborations.</p>
    <a class="text-link" href="/contact/">Let's connect <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: 112px;
    padding-bottom: 104px;
    max-width: 900px;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: 18px;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-heading);
    color: var(--color-text);
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    line-height: 1.12;
    letter-spacing: -0.055em;
    max-width: 850px;
  }

  h1 span {
    display: block;
    color: var(--color-muted);
    font-weight: 500;
  }

  .hero-description {
    color: var(--color-muted);
    font-size: 1.1rem;
    line-height: 1.8;
    max-width: 680px;
    margin-top: 28px;
  }

  .hero-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 26px;
    margin-top: 34px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    border-radius: var(--radius-md);
    font-weight: 600;
    transition: var(--transition);
  }

  .button-primary {
    background: var(--color-accent);
    color: white;
  }

  .button-primary:hover {
    opacity: 0.9;
  }

  .button-secondary {
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .button-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .text-link {
    color: var(--color-accent);
    font-weight: 600;
  }

  .section {
    padding-top: 64px;
    padding-bottom: 64px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 28px;
  }

  h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    letter-spacing: -0.04em;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 230px;
    padding: 26px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: var(--transition);
  }

  .project-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
  }

  .project-label {
    color: var(--color-muted);
    font-size: 0.78rem;
    margin-bottom: 22px;
  }

  .project-card h3 {
    font-size: 1.2rem;
    margin-bottom: 10px;
  }

  .project-card p,
  .secondary-section p,
  .contact-section p {
    color: var(--color-muted);
    line-height: 1.7;
  }

  .card-link {
    color: var(--color-accent);
    font-size: 0.9rem;
    font-weight: 600;
    margin-top: auto;
    padding-top: 24px;
  }

  .secondary-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    border-top: 1px solid var(--color-border);
  }

  .secondary-section > div {
    max-width: 620px;
  }

  .secondary-section p:not(.eyebrow) {
    margin-top: 12px;
  }

  .contact-section {
    border-top: 1px solid var(--color-border);
    padding-bottom: 100px;
  }

  .contact-section p:not(.eyebrow) {
    margin: 14px 0 20px;
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 76px;
      padding-bottom: 64px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .section-heading,
    .secondary-section {
      align-items: flex-start;
      flex-direction: column;
    }

    .section {
      padding-top: 48px;
      padding-bottom: 48px;
    }
  }
</style>
