---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { SITE } from "../config";
import { professionalProjects, stats } from "../data/projects";

const featured = professionalProjects.slice(0, 3);

const posts = (await getCollection("blog"))
  .filter(({ data }) => import.meta.env.DEV || !data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" });

const expertise = [
  {
    title: "Cost optimization",
    text: "Utilisation reviews, right-sizing and service-tier choices that cut the cost of running applications.",
    icon: "M3 3v18h18M7 14l4-4 3 3 5-6",
  },
  {
    title: "Security",
    text: "Vulnerability remediation, hardening and patching for infrastructure that is already live.",
    icon: "M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z",
  },
  {
    title: "Availability",
    text: "Redundancy, backup and recovery reviews so applications stay up through failures and maintenance.",
    icon: "M3 12h4l3-8 4 16 3-8h4",
  },
  {
    title: "DevOps & automation",
    text: "Standardised Azure DevOps pipelines and Terraform-based provisioning for repeatable operations.",
    icon: "M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16",
  },
];
---

<BaseLayout title={`${SITE.name} | ${SITE.tagline}`} description={SITE.description}>
  <section class="hero">
    <div class="aurora" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Azure · DevOps · Cost · Security · Availability</p>
        <h1>
          Hi, I'm Prashant.
          <span class="grad-text">I keep Azure workloads efficient, secure and available.</span>
        </h1>
        <p class="lead">
          Infrastructure and DevOps architect for 50+ applications on Azure
          and Azure DevOps, focused on running them well — cost, security,
          optimisation and availability. Outside work I tinker with a
          Kubernetes home lab and chase light with a camera.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/projects/">View my work</a>
          <a class="btn btn-ghost" href="/about/">About me</a>
        </div>
      </div>

      <div class="terminal" aria-hidden="true">
        <div class="terminal-bar">
          <span></span><span></span><span></span>
          <em>~/prashant</em>
        </div>
        <pre><span class="c-muted">$</span> whoami
<span class="c-acc">prashant-hegde</span>

<span class="c-muted">$</span> cat focus.txt
<span class="c-acc">▸</span> 50+ apps · Azure infra &amp; DevOps
<span class="c-acc">▸</span> Cost · Security · Availability
<span class="c-acc">▸</span> Azure DevOps · Linux · Terraform
<span class="c-acc">▸</span> Home lab tinkerer · photographer

<span class="c-muted">$</span> <span class="caret"></span></pre>
      </div>
    </div>
  </section>

  <section class="container stats reveal">
    {stats.map((s) => (
      <div class="stat">
        <strong class="grad-text">{s.value}</strong>
        <span>{s.label}</span>
      </div>
    ))}
  </section>

  <section class="section container">
    <SectionHeading
      eyebrow="What I do"
      title="Keeping live workloads healthy"
      description="Architecture guidance for applications that are already running — so they cost less, stay secure and stay up."
    />
    <div class="card-grid cols-4">
      {expertise.map((item, i) => (
        <div class="card reveal" style={`--d:${i}`}>
          <span class="icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d={item.icon}></path>
            </svg>
          </span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section container">
    <SectionHeading eyebrow="Professional work" title="Selected focus areas">
      <a class="text-link" href="/projects/">View all <span aria-hidden="true">→</span></a>
    </SectionHeading>
    <div class="card-grid cols-3">
      {featured.map((p, i) => (
        <a class="card reveal" href="/projects/" style={`--d:${i}`}>
          {p.metric ? (
            <div class="metric">
              <strong class="grad-text">{p.metric.value}</strong>
              <span>{p.metric.label}</span>
            </div>
          ) : (
            p.status && <span class="pill pill-live">{p.status}</span>
          )}
          <h3>{p.title}</h3>
          <p>{p.description}</p>
          <div class="tags">
            {p.areas.slice(0, 3).map((a) => <span class="tag">{a}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="container">
    <a class="lab-banner reveal" href="/lab/">
      <div>
        <p class="eyebrow">The lab</p>
        <h2>Where I tinker: a Kubernetes home lab.</h2>
        <p>
          A hobby K3s cluster for self-hosted services and experiments —
          the place I try things I don't get to touch at work, and write down
          what breaks.
        </p>
        <span class="text-link">Explore the lab <span aria-hidden="true">→</span></span>
      </div>
      <div class="lab-art" aria-hidden="true">
        <svg viewBox="0 0 220 160" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="82" y="8" width="56" height="30" rx="7"></rect>
          <rect x="12" y="104" width="56" height="30" rx="7"></rect>
          <rect x="82" y="104" width="56" height="30" rx="7"></rect>
          <rect x="152" y="104" width="56" height="30" rx="7"></rect>
          <path d="M110 38v32M40 104V70h140v34M110 70v34" stroke-linecap="round"></path>
          <circle cx="110" cy="23" r="3" fill="currentColor"></circle>
          <circle cx="40" cy="119" r="3" fill="currentColor"></circle>
          <circle cx="110" cy="119" r="3" fill="currentColor"></circle>
          <circle cx="180" cy="119" r="3" fill="currentColor"></circle>
        </svg>
      </div>
    </a>
  </section>

  <section class="section container">
    <SectionHeading eyebrow="Writing" title="Notes from the field and the lab">
      <a class="text-link" href="/blog/">All articles <span aria-hidden="true">→</span></a>
    </SectionHeading>
    {posts.length > 0 ? (
      <div class="card-grid cols-3">
        {posts.map((post, i) => (
          <a class="card reveal" href={`/blog/${post.id}/`} style={`--d:${i}`}>
            <span class="tag self-start">{post.data.category}</span>
            <h3 class="post-title">{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="meta">{formatDate(post.data.pubDate)}</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="card empty reveal">
        <h3>The first articles are on their way.</h3>
        <p>
          I'm writing up Azure cost and security lessons, DevOps pipeline
          notes and my home-lab experiments. Follow along via
          <a class="text-link" href="/rss.xml">RSS</a>.
        </p>
      </div>
    )}
  </section>

  <section class="container">
    <div class="cta-panel reveal">
      <h2>Want to compare notes?</h2>
      <p>Happy to talk Azure operations, DevOps, home labs or photography.</p>
      <div class="hero-actions center">
        <a class="btn btn-primary" href="/contact/">Let's connect</a>
        <a class="btn btn-ghost" href="/photography/">See my photography</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: 72px 56px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: center;
  }

  h1 {
    font-size: clamp(2.5rem, 5.6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
  }

  h1 span {
    display: block;
    margin-top: 6px;
  }

  .hero-copy .lead {
    max-width: 560px;
    margin: 26px 0 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .hero-actions.center {
    justify-content: center;
  }

  /* Terminal */
  .terminal {
    background: var(--code-bg);
    color: var(--code-text);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md), 0 0 80px -30px var(--glow-1);
    overflow: hidden;
    transform: rotate(1.2deg);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .terminal-bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
  }

  .terminal-bar span:first-child {
    background: #ff6b6b;
  }
  .terminal-bar span:nth-child(2) {
    background: #fbbf24;
  }
  .terminal-bar span:nth-child(3) {
    background: #34d399;
  }

  .terminal-bar em {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-style: normal;
    color: rgba(255, 255, 255, 0.5);
  }

  .terminal pre {
    margin: 0;
    padding: 22px 22px 26px;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.85;
    overflow-x: auto;
  }

  .c-muted {
    color: #7d968a;
  }

  .c-acc {
    color: #34d399;
  }

  .caret {
    display: inline-block;
    width: 8px;
    height: 1em;
    vertical-align: text-bottom;
    background: #34d399;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 28px 30px;
  }

  .stat + .stat {
    border-left: 1px solid var(--border);
  }

  .stat strong {
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .stat span {
    color: var(--muted);
    font-size: 0.88rem;
  }

  /* Expertise cards */
  .icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 18px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
  }

  /* Project cards */
  .metric {
    display: flex;
    flex-direction: column;
    margin-bottom: 14px;
  }

  .metric strong {
    font-family: var(--font-heading);
    font-size: 2rem;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .metric span {
    color: var(--subtle);
    font-size: 0.78rem;
  }

  .card > .pill {
    align-self: flex-start;
    margin-bottom: 18px;
  }

  .self-start {
    align-self: flex-start;
    margin-bottom: 16px;
  }

  .post-title {
    font-size: 1.15rem;
  }

  .meta {
    margin-top: auto;
    padding-top: 20px;
    color: var(--subtle);
    font-size: 0.82rem;
  }

  .empty {
    align-items: flex-start;
    padding: 36px;
  }

  /* Lab banner */
  .lab-banner {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 32px;
    align-items: center;
    padding: 48px;
    background:
      radial-gradient(600px circle at 100% 0%, var(--glow-1), transparent 60%),
      var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition), transform var(--transition);
  }

  .lab-banner:hover {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    transform: translateY(-3px);
  }

  .lab-banner h2 {
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    max-width: 22ch;
  }

  .lab-banner p:not(.eyebrow) {
    color: var(--muted);
    max-width: 520px;
    margin: 14px 0 22px;
  }

  .lab-art {
    color: var(--accent);
    justify-self: center;
    width: min(100%, 260px);
    opacity: 0.9;
  }

  /* CTA */
  .cta-panel {
    margin-top: 72px;
    padding: 64px 28px;
    text-align: center;
    background:
      radial-gradient(520px circle at 20% 0%, var(--glow-1), transparent 60%),
      radial-gradient(520px circle at 85% 100%, var(--glow-2), transparent 60%),
      var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
  }

  .cta-panel h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.7rem);
  }

  .cta-panel p {
    color: var(--muted);
    margin: 14px 0 0;
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .terminal {
      transform: none;
      max-width: 520px;
    }

    .stats {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat:nth-child(3) {
      border-left: 0;
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 680px) {
    .hero {
      padding-block: 44px 36px;
    }

    .lab-banner {
      grid-template-columns: 1fr;
      padding: 28px;
    }

    .lab-art {
      display: none;
    }

    .stat {
      padding: 20px;
    }

    .cta-panel {
      padding: 44px 20px;
    }
  }
</style>
