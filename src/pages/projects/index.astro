
---
import BaseLayout from "../../layouts/BaseLayout.astro";


const professionalProjects = [
  {
    title: "Cloud Architecture & Application Advisory",
description:
  "Advised application teams on cloud cost optimization strategies and architectural improvements, contributing to over $500K in cumulative savings across 100+ applications over three years.",    
    areas: ["Azure", "Cloud Architecture", "Application Advisory"],
  },
  {
    title: "Cloud Cost Optimization",
    description:
      "Identified optimization opportunities and recommended architectural improvements that contributed to over $500K in cumulative cloud cost savings over three years.",
    areas: ["Cost Optimization", "Resource Efficiency", "Architecture"],
    achievement: "$500K+ cumulative savings · 3 years · 100+ applications",
  },
  {
    title: "Cloud Security & Governance",
    description:
      "Provided architectural guidance on cloud security, vulnerability remediation, infrastructure hardening and security best practices.",
    areas: ["Cloud Security", "Vulnerability Management", "Governance"],
  },
  {
    title: "Infrastructure Architecture & Automation",
    description:
      "Designed and recommended standardized infrastructure build approaches using Azure DevOps and Terraform, enabling consistent, repeatable and automated infrastructure provisioning.",
    areas: ["Azure DevOps", "Terraform", "Infrastructure as Code", "CI/CD"],
  },
];

const personalProjects = [
  {
    title: "Kubernetes Home Lab",
    description:
      "Building a persistent, lightweight K3s environment for self-hosted services and hands-on platform engineering.",
    areas: ["K3s", "Linux", "Kubernetes", "Self-hosting"],
    status: "In progress",
  },
  {
    title: "GitOps & Infrastructure as Code",
    description:
      "Exploring Git-driven infrastructure management, automated deployments and reproducible environments.",
    areas: ["Git", "GitOps", "CI/CD", "Automation"],
    status: "Exploring",
  },
  {
    title: "AI-driven Automation",
    description:
      "Exploring AI-assisted and agentic automation to streamline cloud operations, DevOps workflows and repetitive infrastructure management tasks.",
    areas: ["AI", "GitHub Copilot", "Agentic Automation", "DevOps"],
    status: "Exploring",
  },
  {
    title: "Personal Website",
    description:
      "Building a personal platform to document projects, share technical learnings and showcase photography.",
    areas: ["Astro", "GitHub", "Cloudflare Pages"],
    status: "In progress",
  },
];

---

<BaseLayout
  title="Projects | Prashant Hegde"
  description="Professional experience and personal projects in cloud infrastructure, automation, Kubernetes and platform engineering."
  active="projects"
>
  <section class="page-intro container">
    <p class="eyebrow">PROJECTS & EXPERIENCE</p>
    <h1>Things I've worked on<br /><span>and things I'm building.</span></h1>
    <p>
      A collection of professional work, personal projects and technical
      explorations across cloud infrastructure and platform engineering.
    </p>
  </section>

  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">PROFESSIONAL EXPERIENCE</p>
        <h2>Applied in practice</h2>
      </div>
      <p class="section-description">
        Areas of work from my professional experience.
      </p>
    </div>

    <div class="project-grid">
      {professionalProjects.map((project) => (
        <article class="project-card">
          <h3>{project.title}</h3>
          <p>{project.description}</p>
{project.achievement && (
  <div class="achievement">
    <strong>$500K+</strong>
    <span>Cumulative savings · 3 years · 100+ applications</span>
  </div>
)}
<div class="tags">
            {project.areas.map((area) => <span>{area}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section container personal-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">PERSONAL PROJECTS</p>
        <h2>Building and learning</h2>
      </div>
      <p class="section-description">
        Hands-on experiments and projects outside my day-to-day work.
      </p>
    </div>

    <div class="project-grid">
      {personalProjects.map((project) => (
        <article class="project-card">
          <div class="card-top">
            <h3>{project.title}</h3>
            <span class="status">{project.status}</span>
          </div>
          <p>{project.description}</p>
          <div class="tags">
            {project.areas.map((area) => <span>{area}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-intro {
    padding-top: 88px;
    padding-bottom: 72px;
    max-width: 1120px;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    margin-bottom: 18px;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-heading);
    color: var(--color-text);
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.15;
    letter-spacing: -0.05em;
  }

  h1 span {
    color: var(--color-muted);
    font-weight: 500;
  }

  .page-intro > p:last-child {
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.8;
    max-width: 650px;
    margin-top: 24px;
  }

  .section {
    padding-top: 56px;
    padding-bottom: 64px;
    border-top: 1px solid var(--color-border);
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 28px;
  }

  h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    letter-spacing: -0.04em;
  }

  .section-description {
    color: var(--color-muted);
    max-width: 360px;
    line-height: 1.7;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 28px;
  }

  .project-card h3 {
    font-size: 1.2rem;
    margin-bottom: 12px;
  }

.project-card > p {
  color: var(--color-muted);
  line-height: 1.75;
  margin-bottom: 16px;
}

.achievement {
  display: flex;
  flex-direction: column;
  gap: 3px;
  margin: 4px 0 20px;
}

.achievement strong {
  color: var(--color-accent);
  font-family: var(--font-heading);
  font-size: 1.65rem;
  letter-spacing: -0.04em;
}

.achievement span {
  color: var(--color-muted);
  font-size: 0.78rem;
}

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tags span {
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: 5px;
    padding: 5px 9px;
    font-size: 0.76rem;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .status {
    color: var(--color-accent);
    font-size: 0.76rem;
    white-space: nowrap;
    padding-top: 4px;
  }

  .personal-section {
    padding-bottom: 100px;
  }

  @media (max-width: 700px) {
    .page-intro {
      padding-top: 64px;
      padding-bottom: 48px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .card-top {
      flex-direction: column;
    }
  }
</style>

