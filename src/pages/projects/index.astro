---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { professionalProjects, personalProjects } from "../../data/projects";
---

<BaseLayout
  title="Projects | Prashant Hegde"
  description="Professional experience and personal projects in cloud infrastructure, automation, Kubernetes and platform engineering."
  active="projects"
>
  <PageHero
    eyebrow="Projects & experience"
    title="Things I've worked on"
    accent="and things I'm building."
    lead="A collection of professional work, personal projects and technical explorations across cloud infrastructure and platform engineering."
  />

  <section class="section container">
    <SectionHeading
      eyebrow="Professional experience"
      title="Applied in practice"
      description="Areas of work from my professional experience."
    />
    <div class="card-grid cols-2">
      {professionalProjects.map((project, i) => (
        <article class="card is-interactive reveal" style={`--d:${i % 2}`}>
          {project.metric && (
            <div class="metric">
              <strong class="grad-text">{project.metric.value}</strong>
              <span>{project.metric.label}</span>
            </div>
          )}
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <div class="tags">
            {project.areas.map((area) => <span class="tag">{area}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section container">
    <SectionHeading
      eyebrow="Personal projects"
      title="Building and learning"
      description="Hands-on experiments and projects outside my day-to-day work."
    />
    <div class="card-grid cols-2">
      {personalProjects.map((project, i) => (
        <article class="card is-interactive reveal" style={`--d:${i % 2}`}>
          <div class="card-top">
            <h3>{project.title}</h3>
            {project.status && (
              <span class:list={["pill", { "pill-live": project.status === "In progress" }]}>
                {project.status}
              </span>
            )}
          </div>
          <p>{project.description}</p>
          <div class="tags">
            {project.areas.map((area) => <span class="tag">{area}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .metric {
    display: flex;
    flex-direction: column;
    margin-bottom: 16px;
  }

  .metric strong {
    font-family: var(--font-heading);
    font-size: 2.3rem;
    letter-spacing: -0.045em;
    line-height: 1.1;
  }

  .metric span {
    color: var(--subtle);
    font-size: 0.8rem;
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .card-top h3 {
    margin: 0;
  }

  .card-top .pill {
    margin-top: 2px;
  }
</style>
