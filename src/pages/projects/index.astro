---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { professionalProjects, personalProjects } from "../../data/projects";
---

<BaseLayout
  title="Projects | Prashant Hegde"
  description="Azure and Linux architecture, cost optimization, security, reliability and automation across 50+ enterprise applications, plus personal home-lab projects."
  active="projects"
>
  <PageHero
    eyebrow="Projects & experience"
    title="Architecture that works beyond go-live"
    accent="and tinkering on the side."
    lead="Professional work across Azure and Linux, covering architecture, cost optimization, security, reliability and automation, alongside personal projects in my home lab."
  />

  <section class="section container">
    <SectionHeading
      eyebrow="Professional work"
      title="Selected work and impact"
      description="Hands-on architecture and operations across 50+ enterprise applications on Azure and Azure DevOps."
    />
    <div class="card-grid cols-2">
      {professionalProjects.map((project, i) => (
        <article class="card is-interactive reveal" style={`--d:${i % 2}`}>
          {project.metric && (
            <div class="metric">
              <strong class="grad-text">{project.metric.value}</strong>
              <span>{project.metric.label}</span>
            </div>
          )}
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          {project.story && (
            <dl class="story">
              <div><dt>Challenge</dt><dd>{project.story.challenge}</dd></div>
              <div><dt>Approach</dt><dd>{project.story.approach}</dd></div>
              <div><dt>Impact</dt><dd>{project.story.impact}</dd></div>
            </dl>
          )}
          <div class="tags">
            {project.areas.map((area) => <span class="tag">{area}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section container">
    <SectionHeading
      eyebrow="Personal projects"
      title="Tinkering and learning"
      description="Hobby experiments outside my day job — where I try new tools and break things safely."
    />
    <div class="card-grid cols-2">
      {personalProjects.map((project, i) => (
        <article class="card is-interactive reveal" style={`--d:${i % 2}`}>
          <div class="card-top">
            <h3>{project.title}</h3>
            {project.status && (
              <span class:list={["pill", { "pill-live": project.status === "In progress" }]}>
                {project.status}
              </span>
            )}
          </div>
          <p>{project.description}</p>
          <div class="tags">
            {project.areas.map((area) => <span class="tag">{area}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .metric {
    display: flex;
    flex-direction: column;
    margin-bottom: 16px;
  }

  .metric strong {
    font-family: var(--font-heading);
    font-size: 2.3rem;
    letter-spacing: -0.045em;
    line-height: 1.1;
  }

  .metric span {
    color: var(--subtle);
    font-size: 0.8rem;
  }

  .story {
    display: grid;
    gap: 10px;
    margin: 16px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .story dt {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .story dd {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }

  .card-top h3 {
    margin: 0;
  }

  .card-top .pill {
    margin-top: 2px;
  }
</style>
